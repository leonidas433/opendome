---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import DomeCalculator from '../components/DomeCalculator';
---

<Layout>
  <header class="grain-overlay"
          style="margin-bottom:2.5rem;padding:2rem 0 1.5rem;position:relative;">
    <p style="position:relative;z-index:1;font-size:var(--text-caption);font-weight:600;
              text-transform:uppercase;letter-spacing:0.1em;color:var(--accent);margin:0 0 0.75rem;">
      Una herramienta gratuita de
      <a href="https://bosqhabitat.es" target="_blank" rel="noopener"
         style="color:var(--accent);text-decoration:none;">bosqhabitat.es</a>
    </p>
    <h1 style="position:relative;z-index:1;font-size:var(--text-display);
               font-family:var(--font-display);font-weight:400;line-height:0.95;
               letter-spacing:-0.03em;color:var(--text-primary);margin:0 0 1rem;text-wrap:balance;">
      OpenDome<br>
      <span style="color:var(--accent);">calculador de domos.</span>
    </h1>
    <p style="position:relative;z-index:1;font-size:var(--text-hero-sub);
              color:var(--text-secondary);max-width:38ch;margin:0;line-height:1.55;">
      Frecuencias 2V · 3V · 4V. Ángulos exactos de ingletadora y sierra de mesa.
      Gratuito y sin registro.
    </p>
  </header>

  <DomeCalculator client:load />
</Layout>
