---
// src/layouts/Layout.astro
import '../styles/global.css';
import BackToTop from '../components/BackToTop';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OpenDome — Calculador Domo Geodésico | bosqhabitat.es',
  description = 'Calculador gratuito de domos geodésicos 2V · 3V · 4V. Ángulos exactos de ingletadora y sierra de mesa para construcción en madera. Por bosqhabitat.es.',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://domo.bosqhabitat.es').toString()} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={new URL(Astro.url.pathname, 'https://domo.bosqhabitat.es').toString()} />
    <meta property="og:image"       content="https://domo.bosqhabitat.es/og-image.png" />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="OpenDome" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content="https://domo.bosqhabitat.es/og-image.png" />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "OpenDome",
      "description": description,
      "url": "https://domo.bosqhabitat.es",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "Web",
      "inLanguage": "es",
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "publisher": {
        "@type": "Organization",
        "name": "bosqhabitat",
        "url": "https://bosqhabitat.es"
      }
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Boldonse&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>

    <!-- NAV -->
    <nav class="site-nav">
      <div style="max-width:72rem;margin:0 auto;padding:0 1.25rem;
                  display:flex;align-items:center;justify-content:space-between;height:3.25rem;">

        <!-- Logo -->
        <a href="/" style="text-decoration:none;display:flex;align-items:baseline;gap:0.5rem;">
          <span style="font-family:var(--font-display);color:var(--accent);
                       font-size:1.375rem;letter-spacing:-0.02em;">
            OpenDome
          </span>
          <span style="font-size:var(--text-caption);color:var(--text-muted);
                       font-family:var(--font-body);">
            beta
          </span>
        </a>

        <!-- Enlace a bosqhabitat.es -->
        <a href="https://bosqhabitat.es"
           target="_blank"
           rel="noopener noreferrer"
           style="display:flex;align-items:center;gap:0.4rem;text-decoration:none;
                  font-size:0.8125rem;font-family:var(--font-body);
                  color:var(--text-muted);transition:color 0.18s ease;"
           onmouseover="this.style.color='var(--accent)'"
           onmouseout="this.style.color='var(--text-muted)'">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
                  stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="9 22 9 12 15 12 15 22"
                      stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          bosqhabitat.es
        </a>

      </div>
    </nav>

    <!-- MAIN -->
    <main id="main-content" tabindex="-1" style="max-width:72rem;margin:0 auto;padding:2.5rem 1.25rem 5rem;outline:none;">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer style="border-top:1px solid var(--glass-border);padding:1.5rem 1.25rem;">
      <div style="max-width:72rem;margin:0 auto;
                  display:flex;flex-wrap:wrap;align-items:center;
                  justify-content:space-between;gap:0.75rem;">
        <p style="font-size:var(--text-caption);color:var(--text-muted);margin:0;">
          Geometría sobre esfera unidad · longitudes al milímetro · ángulos a 0,1°
        </p>
        <a href="https://bosqhabitat.es"
           target="_blank"
           rel="noopener noreferrer"
           style="font-size:var(--text-caption);color:var(--text-muted);
                  text-decoration:none;font-family:var(--font-body);
                  transition:color 0.18s ease;"
           onmouseover="this.style.color='var(--accent)'"
           onmouseout="this.style.color='var(--text-muted)'">
          Una herramienta de bosqhabitat.es →
        </a>
      </div>
    </footer>

    <!-- BACK TO TOP -->
    <BackToTop client:load />

    <!-- SCROLL REVEAL -->
    <script>
      (function () {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('revealed');
                observer.unobserve(e.target);
              }
            }),
          { threshold: 0.07, rootMargin: '0px 0px -36px 0px' }
        );

        const seen = new WeakSet<Element>();
        function scan(root: Document | Element) {
          const matches: Element[] =
            root instanceof Element && root.matches('[data-reveal]') ? [root] : [];
          const found = matches.concat(
            Array.from(root.querySelectorAll('[data-reveal]'))
          );
          found.forEach((el) => {
            if (seen.has(el)) return;
            seen.add(el);
            observer.observe(el);
          });
        }

        scan(document);

        // Los elementos [data-reveal] viven dentro de islas React (client:load)
        // que hidratan después de este script — observamos las inserciones.
        const mo = new MutationObserver((muts) => {
          for (const m of muts) {
            m.addedNodes.forEach((n) => {
              if (n.nodeType === 1) scan(n as Element);
            });
          }
        });
        mo.observe(document.body, { childList: true, subtree: true });
      })();
    </script>

  </body>
</html>
